# Copy to .env and adjust (optional: the stack runs without it).
# docker compose passes every variable from .env to the app containers (env_file), so any
# setting from app/config.py can be overridden here. DATABASE_URL is fixed by compose.

# Leave empty to run in no-key mode: the service still sends a real request to the
# Anthropic API, then uses a static draft after a random 5-30 s delay.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low
# LLM_RATE_LIMIT_PER_MINUTE=60
# GENERATION_CONCURRENCY=30
# WEBHOOK_TIMEOUT_SECONDS=1.5
# REPLY_URL_ALLOWED_HOSTS=helpdesk-mock,helpdesk.example.com

# Mock helpdesk misbehaviour (share of reply requests)
# MOCK_REPLY_FAIL_RATE=0.2            # 5xx, reply NOT stored
# MOCK_REPLY_LOST_RESPONSE_RATE=0.1   # reply stored, response hangs past the client timeout
