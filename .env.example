# Copy to .env and adjust. docker compose reads .env automatically.

# Leave empty to run in no-key mode: the service still sends a real request to the
# Anthropic API, then uses a static draft after a random 5-30 s delay.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low
# LLM_RATE_LIMIT_PER_MINUTE=60

# Mock helpdesk misbehaviour (share of reply requests)
# MOCK_REPLY_FAIL_RATE=0.2            # 5xx, reply NOT stored
# MOCK_REPLY_LOST_RESPONSE_RATE=0.1   # reply stored, response hangs past the client timeout
